@page "/train/{SetId:guid}/{CycleId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@using Woodpecker.Web.Services
@inject WoodpeckerApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Entraînement</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <p>Vous devez être connecté. <a href="/login">Se connecter</a></p>
}
else if (_error is not null)
{
    <p class="text-danger">@_error</p>
    <a class="btn btn-secondary" href="/sets">Retour à mes sets</a>
}
else if (_puzzleIds is null)
{
    <p>Chargement...</p>
}
else if (_currentIndex >= _puzzleIds.Count)
{
    <h1>Set terminé !</h1>

    @if (_stats is not null)
    {
        <div class="card" style="max-width: 400px;">
            <p style="margin: 0 0 0.5rem;">Réussite : <strong>@(_stats.SuccessCount)/@(_stats.PuzzleCount)</strong> (@((_stats.SuccessRate * 100).ToString("0")) %)</p>
            <p style="margin: 0 0 0.5rem;">Temps total : <strong>@_stats.TotalDuration.ToString(@"mm\:ss")</strong></p>
            <p style="margin: 0;">Temps moyen par puzzle : <strong>@_stats.AverageDuration.ToString(@"mm\:ss")</strong></p>
        </div>
    }

    @if (_progression is { Count: > 1 })
    {
        <h2>Progression sur ce set</h2>
        <CycleProgression Cycles="_progression" />
    }

    <div style="display: flex; gap: 0.6rem;">
        <button class="btn btn-primary" @onclick="StartNextCycleAsync">Refaire ce set (cycle suivant)</button>
        <a class="btn btn-secondary" href="/sets">Retour à mes sets</a>
    </div>
}
else
{
    <div class="train-layout">
        <div style="display: flex; align-items: baseline; gap: 1rem;">
            <h1 style="margin-bottom: 0.5rem;">Puzzle @(_alreadyAttemptedCount + _currentIndex + 1) / @(_alreadyAttemptedCount + _puzzleIds.Count)</h1>
            <span class="text-muted">⏱ @Elapsed.ToString(@"mm\:ss")</span>
        </div>

        @if (_currentPuzzle is not null)
        {
          <div class="train-main">
            <div class="card">
                @* @key : nouvelle instance par puzzle, sinon le plateau surligne la différence entre deux positions sans rapport. *@
                <ChessBoard @key="_currentPuzzle.Id" Fen="@_boardFen" Flipped="_boardFlipped" Verdict="_verdict"
                            Locked="_busy || _failed" OnMoveSubmitted="SubmitMoveAsync" />
                <div class="puzzle-footer">
                    <span class="text-muted">Rating : @_currentPuzzle.Rating</span>
                    @if (_failed)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="NextPuzzleAsync">Puzzle suivant →</button>
                    }
                </div>
            </div>

            <TimesPanel PuzzleIds="_setPuzzleIds" Attempts="_attempts" PreviousAttempts="_previousAttempts"
                        PreviousCycleNumber="_previousCycleNumber" CurrentPuzzleId="_currentPuzzle.Id" Elapsed="Elapsed" />
          </div>
        }
    </div>
}

@code {
    [Parameter] public Guid SetId { get; set; }
    [Parameter] public Guid CycleId { get; set; }

    private List<Guid>? _puzzleIds;
    private int _currentIndex;

    // À la reprise d'un cycle, _puzzleIds ne contient que les puzzles restants : on garde le
    // nombre de ceux déjà tentés pour afficher la vraie position ("4 / 10", pas "1 / 7").
    private int _alreadyAttemptedCount;

    // Données du panneau des temps : set complet (ordre d'origine), tentatives de ce cycle et
    // du cycle précédent terminé, indexées par puzzle.
    private List<Guid> _setPuzzleIds = [];
    private Dictionary<Guid, CycleAttemptDto> _attempts = [];
    private Dictionary<Guid, CycleAttemptDto> _previousAttempts = [];
    private int? _previousCycleNumber;
    private PuzzleDto? _currentPuzzle;
    private string _boardFen = string.Empty;
    private bool _boardFlipped;
    private int _currentMoveIndex;
    private MoveVerdict? _verdict;
    private bool _busy;
    private bool _failed;
    private DateTime _puzzleStartedAt;
    private CycleStatsDto? _stats;
    private IReadOnlyList<CycleProgressionDto>? _progression;
    private string? _error;
    private System.Timers.Timer? _timer;
    private Guid _loadedCycleId;

    private TimeSpan Elapsed => DateTime.UtcNow - _puzzleStartedAt;

    // OnParametersSetAsync plutôt que OnInitializedAsync : naviguer vers /train/{set}/{autreCycle}
    // depuis cette page (bouton "cycle suivant") réutilise la même instance de composant, il
    // faut donc détecter le changement de CycleId et repartir d'un état vierge.
    protected override async Task OnParametersSetAsync()
    {
        await AuthState.EnsureRestoredAsync();
        if (!AuthState.IsAuthenticated || CycleId == _loadedCycleId)
            return;

        _loadedCycleId = CycleId;
        _timer?.Stop();
        _puzzleIds = null;
        _currentIndex = 0;
        _currentPuzzle = null;
        _stats = null;
        _progression = null;
        _error = null;

        try
        {
            var cycle = await Api.GetCycleAsync(CycleId);
            if (cycle?.IsAbandoned == true)
            {
                _error = "Ce cycle a été abandonné.";
                return;
            }

            var set = await Api.GetSetAsync(SetId);

            // Reprise d'un cycle en cours : on ne repropose pas les puzzles déjà tentés
            // (une seule tentative par puzzle et par cycle, cf. SubmitPuzzleAttemptHandler).
            var attempted = cycle?.AttemptedPuzzleIds.ToHashSet() ?? [];
            _puzzleIds = (set?.PuzzleIds ?? []).Where(id => !attempted.Contains(id)).ToList();
            _alreadyAttemptedCount = (set?.PuzzleIds.Count ?? 0) - _puzzleIds.Count;
            _setPuzzleIds = set?.PuzzleIds.ToList() ?? [];

            var detail = await Api.GetCycleDetailAsync(CycleId);
            _attempts = detail?.Attempts.ToDictionary(a => a.PuzzleId) ?? [];
            _previousAttempts = detail?.PreviousAttempts.ToDictionary(a => a.PuzzleId) ?? [];
            _previousCycleNumber = detail?.PreviousCycleNumber;

            await LoadCurrentPuzzleAsync();
        }
        catch (Exception ex)
        {
            _error = $"Impossible de charger l'entraînement : {ex.Message}";
            return;
        }

        _timer ??= CreateTimer();
        if (_currentPuzzle is not null)
            _timer.Start();
    }

    private System.Timers.Timer CreateTimer()
    {
        var timer = new System.Timers.Timer(1000);
        timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        return timer;
    }

    private async Task NextPuzzleAsync()
    {
        _currentIndex++;
        try
        {
            await LoadCurrentPuzzleAsync();
            if (_currentPuzzle is not null && _currentIndex < _puzzleIds!.Count)
                _timer?.Start();
        }
        catch (Exception ex)
        {
            _error = $"Impossible de charger le puzzle suivant : {ex.Message}";
            _timer?.Stop();
        }
    }

    private async Task LoadCurrentPuzzleAsync()
    {
        _verdict = null;
        _failed = false;

        if (_puzzleIds is null || _currentIndex >= _puzzleIds.Count)
        {
            _stats = await Api.GetCycleStatsAsync(CycleId);
            _progression = await Api.GetSetProgressionAsync(SetId);
            _timer?.Stop();
            return;
        }

        _currentPuzzle = await Api.GetPuzzleAsync(_puzzleIds[_currentIndex]);
        _boardFen = _currentPuzzle!.PlayableFen;
        // Le camp qui doit trouver le premier coup est celui au trait dans PlayableFen (après
        // le coup de mise en place automatique) : on affiche l'échiquier de son point de vue,
        // et on ne retourne plus la vue ensuite (même après un coup adverse automatique).
        _boardFlipped = _boardFen.Split(' ')[1] == "b";
        _currentMoveIndex = 1; // l'indice 0 (mise en place) est déjà joué dans PlayableFen
        _puzzleStartedAt = DateTime.UtcNow;
    }

    // Pause pendant laquelle le badge de verdict reste visible avant d'enchaîner (réponse
    // adverse ou puzzle suivant).
    private const int VerdictDisplayMs = 700;

    private async Task SubmitMoveAsync(string move)
    {
        if (_currentPuzzle is null || _busy)
            return;

        _busy = true;
        try
        {
            var duration = DateTime.UtcNow - _puzzleStartedAt;
            SubmitPuzzleAttemptResponse result;
            try
            {
                result = await Api.SubmitAttemptAsync(CycleId, _currentPuzzle.Id, _currentMoveIndex, move, duration);
            }
            catch (Exception ex)
            {
                _error = $"Impossible d'enregistrer le coup : {ex.Message}";
                _timer?.Stop();
                return;
            }

            if (result.IsPuzzleComplete)
                _attempts[_currentPuzzle.Id] = new CycleAttemptDto(_currentPuzzle.Id, result.IsCorrect, duration);

            // Le badge se pose sur la case d'arrivée du coup joué (move = "e2e4" -> "e4").
            _verdict = new MoveVerdict(move[2..4], result.IsCorrect);

            // Coup faux : le puzzle est terminé côté serveur, mais on laisse l'utilisateur voir le
            // verdict et passer lui-même au suivant (plateau verrouillé, badge rouge conservé).
            if (result.IsPuzzleComplete && !result.IsCorrect)
            {
                _failed = true;
                _timer?.Stop();
                return;
            }

            StateHasChanged();
            await Task.Delay(VerdictDisplayMs);
            _verdict = null;

            if (result.IsPuzzleComplete)
            {
                await NextPuzzleAsync();
                return;
            }

            // Coup correct mais solution pas terminée : le serveur a déjà rejoué la réponse
            // automatique de l'adversaire, on réaffiche juste la position résultante.
            _boardFen = result.ResultingFen!;
            _currentMoveIndex = result.NextMoveIndex!.Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartNextCycleAsync()
    {
        try
        {
            var cycleId = await Api.StartCycleAsync(SetId);
            Nav.NavigateTo($"/train/{SetId}/{cycleId}");
        }
        catch (Exception ex)
        {
            _error = $"Impossible de démarrer le cycle suivant : {ex.Message}";
        }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
