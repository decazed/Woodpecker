@page "/"
@rendermode InteractiveServer
@using Woodpecker.Web.Services
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Woodpecker</PageTitle>

<h1>Woodpecker</h1>
<p>Entraînement tactique aux échecs par répétition de sets de puzzles, de plus en plus vite à chaque cycle.</p>

<div class="card" style="max-width: 480px;">
    @if (AuthState.IsAuthenticated)
    {
        <p style="margin-top: 0;">Content de te revoir, @AuthState.Email.</p>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/sets")'>Mes sets</button>
    }
    else
    {
        <p style="margin-top: 0;">Connecte-toi pour créer ou reprendre un set de puzzles.</p>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Se connecter</button>
    }
</div>

@code {
    protected override Task OnInitializedAsync() => AuthState.EnsureRestoredAsync();
}
