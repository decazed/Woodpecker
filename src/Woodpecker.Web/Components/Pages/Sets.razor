@page "/sets"
@rendermode InteractiveServer
@using Woodpecker.Web.Services
@inject WoodpeckerApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Mes sets</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <p>Vous devez être connecté. <a href="/login">Se connecter</a></p>
}
else
{
    <h1>Commencer un set</h1>

    @if (_templates is null)
    {
        <p>Chargement...</p>
    }
    else
    {
        <ul class="card-list">
            @foreach (var template in _templates)
            {
                <li class="card-list-item">
                    <div>
                        <strong>@template.Name</strong>
                        <div class="meta">@template.Description</div>
                        @if (_choosingTemplate == template.Key)
                        {
                            <div class="count-choices" role="group" aria-label="Nombre de puzzles">
                                <span class="meta">Nombre de puzzles :</span>
                                @foreach (var count in template.PuzzleCountChoices)
                                {
                                    <button class="btn btn-sm btn-secondary"
                                            disabled="@(_busy || count > template.AvailablePuzzleCount)"
                                            @onclick="() => StartFromTemplateAsync(template.Key, count)">
                                        @count
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-actions">
                        @if (_choosingTemplate == template.Key)
                        {
                            <button class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => _choosingTemplate = null">Annuler</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary"
                                    disabled="@(_busy || template.AvailablePuzzleCount < (template.PuzzleCountChoices.FirstOrDefault()))"
                                    @onclick="() => _choosingTemplate = template.Key">
                                Commencer
                            </button>
                        }
                    </div>
                </li>
            }
        </ul>
    }

    @if (_sets is { Count: > 0 })
    {
        <hr />
        <h2>Mes sets</h2>
        <p>Refaire un set en cycles successifs, de plus en plus vite : c'est tout le principe de la méthode.</p>

        <ul class="card-list">
            @foreach (var set in _sets)
            {
                <li class="card-list-item">
                    <div>
                        <strong>@set.Name</strong>
                        @if (set.ActiveCycleId is not null)
                        {
                            <div class="meta">Cycle en cours · @set.ActiveCycleAttemptedCount / @set.PuzzleCount puzzles</div>
                            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="@set.PuzzleCount" aria-valuenow="@set.ActiveCycleAttemptedCount">
                                <div class="progress-fill" style="width: @(100 * set.ActiveCycleAttemptedCount / Math.Max(set.PuzzleCount, 1))%"></div>
                            </div>
                        }
                        else
                        {
                            <div class="meta">@set.PuzzleCount puzzle(s)</div>
                        }
                    </div>
                    <div class="card-actions">
                        @if (_pending is { } pending && pending.SetId == set.Id)
                        {
                            <span class="meta">@(pending.Action == PendingAction.Abandon ? "Abandonner ce cycle ?" : "Supprimer ce set et son historique ?")</span>
                            <button class="btn btn-sm btn-danger" disabled="@_busy" @onclick="ConfirmPendingAsync">Confirmer</button>
                            <button class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => _pending = null">Annuler</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => ToggleProgressionAsync(set.Id)">
                                @(_progressions.ContainsKey(set.Id) ? "Masquer" : "Progression")
                            </button>
                            @if (set.ActiveCycleId is Guid activeCycleId)
                            {
                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => ResumeCycle(set.Id, activeCycleId)">Reprendre le cycle</button>
                                <button class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => _pending = new(set.Id, activeCycleId, PendingAction.Abandon)">Abandonner le cycle</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => StartCycleAsync(set.Id)">Nouveau cycle</button>
                            }
                            <button class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => _pending = new(set.Id, null, PendingAction.Delete)">Supprimer</button>
                        }
                    </div>
                    @if (_progressions.TryGetValue(set.Id, out var progression))
                    {
                        <div style="flex-basis: 100%;">
                            <CycleProgression Cycles="progression" />
                        </div>
                    }
                </li>
            }
        </ul>
    }

    @if (_error is not null)
    {
        <p class="text-danger">@_error</p>
    }
}

@code {
    private IReadOnlyList<SetTemplateDto>? _templates;
    private IReadOnlyList<PuzzleSetSummaryDto>? _sets;
    private readonly Dictionary<Guid, IReadOnlyList<CycleProgressionDto>> _progressions = new();
    private string? _error;
    private bool _busy;

    // Modèle dont l'utilisateur est en train de choisir le nombre de puzzles (un seul à la fois).
    private string? _choosingTemplate;

    // Action destructive en attente de confirmation (une seule à la fois, sur une ligne).
    private enum PendingAction { Abandon, Delete }
    private record PendingConfirmation(Guid SetId, Guid? CycleId, PendingAction Action);
    private PendingConfirmation? _pending;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.EnsureRestoredAsync();
        if (!AuthState.IsAuthenticated)
            return;

        try
        {
            _templates = await Api.GetSetTemplatesAsync();
            _sets = await Api.GetMySetsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Impossible de charger les données depuis l'API : {ex.Message}";
            _templates = [];
            _sets = [];
        }
    }

    // Un clic sur un nombre = un set créé à partir du modèle + son premier cycle démarré.
    private async Task StartFromTemplateAsync(string templateKey, int puzzleCount)
    {
        _error = null;
        _busy = true;
        try
        {
            var setId = await Api.CreateSetFromTemplateAsync(templateKey, puzzleCount);
            var cycleId = await Api.StartCycleAsync(setId);
            Nav.NavigateTo($"/train/{setId}/{cycleId}");
        }
        catch (Exception ex)
        {
            _error = $"Impossible de commencer ce set : {ex.Message}";
            _busy = false;
        }
    }

    private async Task StartCycleAsync(Guid setId)
    {
        _error = null;
        _busy = true;
        try
        {
            var cycleId = await Api.StartCycleAsync(setId);
            Nav.NavigateTo($"/train/{setId}/{cycleId}");
        }
        catch (Exception ex)
        {
            _error = $"Impossible de démarrer le cycle : {ex.Message}";
            _busy = false;
        }
    }

    private async Task ConfirmPendingAsync()
    {
        if (_pending is not { } pending)
            return;

        _error = null;
        _busy = true;
        try
        {
            if (pending.Action == PendingAction.Abandon)
                await Api.AbandonCycleAsync(pending.CycleId!.Value);
            else
                await Api.DeleteSetAsync(pending.SetId);

            _sets = await Api.GetMySetsAsync();
            _pending = null;
        }
        catch (Exception ex)
        {
            _error = $"Action impossible : {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResumeCycle(Guid setId, Guid cycleId) => Nav.NavigateTo($"/train/{setId}/{cycleId}");

    private async Task ToggleProgressionAsync(Guid setId)
    {
        if (_progressions.Remove(setId))
            return;

        _error = null;
        try
        {
            _progressions[setId] = await Api.GetSetProgressionAsync(setId);
        }
        catch (Exception ex)
        {
            _error = $"Impossible de charger la progression : {ex.Message}";
        }
    }
}
