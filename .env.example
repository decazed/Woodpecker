# Copier ce fichier en .env (non versionné) et adapter les valeurs.
# Lu automatiquement par docker compose.

# Mot de passe PostgreSQL (utilisateur et base : woodpecker)
POSTGRES_PASSWORD=woodpecker

# Clé de signature des JWT : 32 caractères minimum (HMAC-SHA256)
JWT_KEY=dev-only-secret-key-change-me-in-production-min-32-chars
